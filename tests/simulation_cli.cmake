function(run expected)
    execute_process(COMMAND "${CLI_EXECUTABLE}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}; stderr=${error}; stdout=${output}")
    endif()
    set(last_stdout "${output}" PARENT_SCOPE)
endfunction()
function(stable_csv result text)
    string(REGEX REPLACE ",[^,\n]*,process_cpu_decoder_calls" ",NA,process_cpu_decoder_calls" stable "${text}")
    set(${result} "${stable}" PARENT_SCOPE)
endfunction()
