function(check_formats csv json expected_rows)
    file(STRINGS "${csv}" rows)
    list(POP_FRONT rows header)
    string(REPLACE "," ";" keys "${header}")
    list(LENGTH keys columns)
    file(READ "${json}" document)
    string(JSON row_count LENGTH "${document}")
    if(NOT columns EQUAL 40 OR NOT row_count EQUAL expected_rows)
        message(FATAL_ERROR "Wrong versioned record shape")
    endif()
    math(EXPR last_row "${row_count}-1")
    foreach(row RANGE ${last_row})
        list(GET rows ${row} text)
        string(REPLACE "," ";" values "${text}")
        foreach(column RANGE 39)
            list(GET keys ${column} key)
            list(GET values ${column} csv_value)
            string(JSON type TYPE "${document}" ${row} ${key})
            string(JSON value GET "${document}" ${row} ${key})
            if(type STREQUAL "BOOLEAN")
                if(value)
                    set(value 1)
                else()
                    set(value 0)
                endif()
            elseif(type STREQUAL "NULL")
                set(value NA)
            endif()
            if(type STREQUAL "NUMBER")
                if(NOT value EQUAL csv_value)
                    message(FATAL_ERROR "Numeric CSV/JSON mismatch: ${key}")
                endif()
            elseif(NOT "${value}" STREQUAL "${csv_value}")
                message(FATAL_ERROR "CSV/JSON mismatch: ${key}")
            endif()
        endforeach()
        string(JSON full GET "${document}" ${row} full_candidates_evaluated)
        string(JSON generated GET "${document}" ${row} partial_patterns_generated)
        string(JSON frames GET "${document}" ${row} frames)
        string(JSON bound GET "${document}" ${row} stop_bound_frames)
        string(JSON exhausted GET "${document}" ${row} stop_exhausted_frames)
        string(JSON budget GET "${document}" ${row} query_limit_hit_frames)
        string(JSON resource GET "${document}" ${row} resource_limit_hit_frames)
        math(EXPR stopped "${bound}+${exhausted}+${budget}+${resource}")
        if(generated LESS full OR NOT stopped EQUAL frames)
            message(FATAL_ERROR "Inconsistent generated/evaluated or stop counts")
        endif()
    endforeach()
endfunction()
